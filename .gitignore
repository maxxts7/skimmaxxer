# python bytecode from the pipeline stages
__pycache__/
*.py[cod]

# scratch drafts written while a stage runs
tmp/

# screenshots taken while checking a page in a real browser. A look at the
# work rather than part of it, and 20MB of it by now.
.playwright-mcp/

# os cruft
.DS_Store
Thumbs.db
desktop.ini
node_modules/

# The papers themselves. Not ours to publish, and the reader no longer opens a
# copy from here - arXiv and OpenAI's CDN both send access-control-allow-origin,
# so pdf.js reads their file directly and the bytes never pass through this
# site. Kept on disk because ingest still needs them; out of the repo so the
# deploy stops serving 55MB of other people's papers at guessable URLs.
papers/*/paper.pdf
# Except one: metr.org sends no CORS header, so pdf.js cannot read that report
# cross-origin and the reader still opens this copy.
!papers/hugging-face-incident/paper.pdf
